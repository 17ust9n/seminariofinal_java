<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/navy"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Título Principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modificar Grupo"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Nombre del Grupo"
        android:textColor="#8aa0b3"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- Campo de Entrada del Nombre -->
    <EditText
        android:id="@+id/etGEditName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="14dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <!-- Contador Dinámico de Tildes -->
    <TextView
        android:id="@+id/tvEditGroupCounterLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Miembros del Grupo (0 seleccionados)"
        android:textColor="#8aa0b3"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Lista de Contactos con Checkboxes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEditGroupMembers"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:padding="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Botonera Inferior en una Sola Línea -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancelEditGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancelar"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSaveEditGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/green_accent"
            android:text="💾 Modificar Grupo"
            android:textColor="#04240f"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
